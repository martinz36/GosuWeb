// This is your Prisma schema file for PostgreSQL on Neon

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoPago {
  pendiente
  pagado
  fallido
}

enum EstadoEnvio {
  procesando
  enviado
  entregado
}

enum EstadoAfiliado {
  pendiente
  aprobado
  rechazado
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  slug      String     @unique
  productos Producto[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Producto {
  id             String     @id @default(cuid())
  nombre         String
  slug           String     @unique
  descripcion    String?    @db.Text
  precioBase     Decimal    @db.Decimal(10, 2)
  activo         Boolean    @default(true)
  imagenes       String[]   // Array de URLs de imágenes

  // SEO Metadata
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  categoriaId    String?
  categoria      Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  variantes      Variante[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Variante {
  id         String      @id @default(cuid())
  sku        String      @unique
  titulo     String      // Ej: 'Rojo / L' o 'Mate / 100u'
  precio     Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  opciones   Json?       // Atributos dinámicos en formato JSON

  productoId String
  producto   Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  itemsOrden ItemOrden[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Cupon {
  id                  String    @id @default(cuid())
  codigo              String    @unique
  descuentoPorcentaje Int?      // Ej: 10 para 10%
  descuentoMonto      Decimal?  @db.Decimal(10, 2) // Ej: 15.00 para S/. 15 de descuento
  limiteUso           Int?
  vecesUsado          Int       @default(0)
  fechaExpiracion     DateTime?
  activo              Boolean   @default(true)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         String   @default("admin")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Orden {
  id           String        @id @default(cuid())
  numeroOrden  Int           @unique @default(autoincrement())
  clienteEmail String
  total        Decimal       @db.Decimal(10, 2)
  estadoPago   EstadoPago    @default(pendiente)
  estadoEnvio  EstadoEnvio   @default(procesando)
  datosEnvio   Json          // JSON con dirección, nombre, teléfono, etc.

  items        ItemOrden[]
  referralSale ReferralSale?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ItemOrden {
  id             String   @id @default(cuid())
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)

  ordenId        String
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  varianteId     String
  variante       Variante @relation(fields: [varianteId], references: [id], onDelete: Restrict)
}

// PROGRAMA DE AFILIADOS
model Affiliate {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String?
  code           String         @unique // Ej: "GOSU-CARLOS"
  commissionRate Decimal        @default(10.00) @db.Decimal(5, 2)
  balancePending Decimal        @default(0.00) @db.Decimal(10, 2)
  balancePaid    Decimal        @default(0.00) @db.Decimal(10, 2)
  paymentInfo    String?        // Yape, Plin, CCI, Banco
  status         EstadoAfiliado @default(aprobado)
  totalClicks    Int            @default(0)

  sales          ReferralSale[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ReferralSale {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Orden     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderAmount Decimal   @db.Decimal(10, 2)
  commission  Decimal   @db.Decimal(10, 2)
  status      String    @default("pending") // "pending" | "paid"

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// STORE SETTINGS & PAYMENT GATEWAYS
model StoreSettings {
  id                    String   @id @default("default")
  
  // Mercado Pago Perú
  mercadoPagoActive     Boolean  @default(false)
  mercadoPagoMode       String   @default("sandbox")
  mpPublicSandboxKey    String?
  mpAccessSandboxToken  String?
  mpPublicProdKey       String?
  mpAccessProdToken     String?

  // Stripe
  stripeActive          Boolean  @default(false)
  stripeMode            String   @default("sandbox")
  stripePublishableKey  String?
  stripeSecretKey       String?

  // Culqi
  culqiActive           Boolean  @default(true)
  culqiPublicKey        String?
  culqiSecretKey       String?

  // Configuración de Envío Gratis
  freeShippingThreshold Decimal? @default(200.00) @db.Decimal(10, 2)

  updatedAt             DateTime @updatedAt
}

// COSTOS Y ZONAS DE ENVÍO DINÁMICAS
model ShippingZone {
  id            String   @id @default(cuid())
  countryCode   String   // Ej: "PE", "MX", "CL", "CR"
  region        String?  // Ej: "Lima", "Arequipa", "CDMX"
  rate          Decimal  @db.Decimal(10, 2) // Ej: 12.00
  currency      String   @default("PEN") // Ej: "PEN", "USD"
  estimatedDays String?  // Ej: "24 a 48 horas", "3 a 5 días hábiles"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
